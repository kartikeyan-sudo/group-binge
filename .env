MONGODB_URI=mongodb+srv://kartikeyandubey61:cQeQXqHlpEMRsifg@cluster1.ul15v2w.mongodb.net/group-binge
#
# Option 2: MongoDB Atlas (Cloud - Free Tier Available)
# Get your connection string from: https://www.mongodb.com/cloud/atlas
# Steps:
#   1. Sign up at https://www.mongodb.com/cloud/atlas
#   2. Create a FREE M0 cluster
#   3. Create a database user (username & password)
#   4. Whitelist your IP (or use 0.0.0.0/0 for development)
#   5. Click "Connect" -> "Connect your application"
#   6. Copy the connection string and replace <password> with your actual password
#
# Example MongoDB Atlas connection string:
# MONGODB_URI=mongodb+srv://myusername:mypassword@cluster0.xxxxx.mongodb.net/group-binge?retryWrites=true&w=majority
#
# Note: Replace:
#   - myusername: your MongoDB Atlas username
#   - mypassword: your MongoDB Atlas password
#   - cluster0.xxxxx: your actual cluster address
#   - group-binge: your database name

# ========================================
# SERVER CONFIGURATION
# ========================================
# Port on which the server will run
PORT=3000

# Host (usually localhost for development)
HOST=localhost

# ========================================
# CORS CONFIGURATION
# ========================================
# Allowed origins for CORS (use * for development, specific URLs for production)
CORS_ORIGIN=*

# ========================================
# ENVIRONMENT
# ========================================
# Set to 'production' when deploying to production
NODE_ENV=development

# ========================================
# DEBUG MODE
# ========================================
# Set to 'true' to enable detailed logging
DEBUG=true
